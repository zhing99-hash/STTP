      "id": "MX:def:manifold",
      "labels": [
        "Entity",
        "Formula",
        "Definition"
      ],
      "props": {
        "name": "definition",
        "type": "definition",
        "latex": "M",
        "informal": "A smooth n-dimensional manifold M is a second-countable Hausdorff topological space equipped with a maximal smooth atlas of charts.",
        "proof": null,
        "symbols": [
          "M",
          "n"
        ],
        "domain": "math.DG",
        "source_ref": "arXiv:2103.12345",
        "source": "mathxiv",
