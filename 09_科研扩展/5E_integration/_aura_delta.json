        "version": "v0.1",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit"
      }
    },
    {
      "id": "MX:def:tangent_space",
      "labels": [
        "Entity",
        "Formula",
        "Definition"
      ],
      "props": {
        "name": "definition",
        "type": "definition",
        "latex": "T_p M",
        "informal": "The tangent space T_p M at a point p in M is the vector space of all tangent vectors (derivations) at p.",
        "proof": null,
        "symbols": [
          "T_p M",
          "M",
          "p"
        ],
        "domain": "math.DG",
        "source_ref": "arXiv:2103.12345",
        "source": "mathxiv",
