# ============================================================================
# 公式知识图谱 · Neo4j 部署环境变量样例
# 复制为 .env 后按需修改密码（默认密码已设为 formula_graph_2026）
# docker-compose.yml 与 Python 脚本（load_neo4j.py / verify_deploy.py）
# 均读取这些变量。
#
# 重要：URI scheme 决定 TLS 与证书验证方式
#   bolt://          明文（仅本地 docker 可用）
#   neo4j://         加密 + 验证系统 CA 证书（本地 docker 默认）
#   neo4j+s://       加密 + 验证系统 CA 证书（Aura 商业 / 自签名 CA 不可用）
#   neo4j+ssc://     加密 + 跳过证书验证（Aura 免费实例 · 必须）
# ============================================================================

# ---- Python 驱动 / 脚本使用 ----
# 本地 docker compose
# NEO4J_URI=neo4j://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=formula_graph_2026
# NEO4J_DATABASE=neo4j

# Neo4j Aura 免费实例（注意 ssc 后缀！Aura 自签名证书用 +s 会认证失败）
NEO4J_URI=neo4j+ssc://<your-aura-instance-id>.databases.neo4j.io
NEO4J_USER=<your-username>
NEO4J_PASSWORD=<your-password>
NEO4J_DATABASE=<your-database>

# ---- docker-compose 使用（格式：user/password，须与上面一致）----
NEO4J_AUTH=neo4j/formula_graph_2026

# ---- APOC 插件（社区版默认关闭部分过程，此处已打开）----
NEO4J_PLUGINS=["apoc"]

# ---- CSV 导入开关（离线 neo4j-admin import 专用）----
# Neo4j 5.x 社区版默认禁止 CSV 导入；开启后 reload 时重启生效
# NEO4J_dbms_security_procedures_unrestricted=apoc.*
# NEO4J_dbms_directories_import=import

# ---- Aura 部署关键提示 ----
# 1. 下载的 .txt 文件里有 NEO4J_URI / NEO4J_USERNAME / NEO4J_PASSWORD / NEO4J_DATABASE
# 2. 必须把 URI 的 +s 改成 +ssc（self-signed certificate），否则 driver 会因证书验证失败返回
#    "Unable to retrieve routing information"
# 3. NEO4J_USERNAME 通常等于 NEO4J_DATABASE（Aura 免费实例以 instance ID 作为用户名和库名）
# 4. Neo4j Browser 走的是 Aura 的 WebSocket gateway，不验证客户端证书，所以浏览器能直接访问，
#    但 Python driver 走 Bolt 协议，必须按上面的 scheme 调整