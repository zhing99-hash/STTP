  "nodes": [
    {
      "id": "CE:fo:mass_action",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Law of mass action (equilibrium constant)",
        "ntype": "formula",
        "domain": "chem.equilibrium",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T08:54:02.662433",
        "latex": "K=\\frac{[C]^{c}[D]^{d}}{[A]^{a}[B]^{b}}",
        "informal": "对 aA+bB ⇌ cC+dD，平衡常数等于产物浓度幂之积比反应物浓度幂之积。"
      }
    },
    {
      "id": "CE:fo:reaction_quotient",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Reaction quotient",
        "ntype": "formula",
        "domain": "chem.equilibrium",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T08:54:02.662433",
        "latex": "Q=\\frac{[C]^{c}[D]^{d}}{[A]^{a}[B]^{b}}",
        "informal": "与 K 同形，但用任意时刻浓度；平衡时 Q=K，Q<K 反应正向、Q>K 逆向。"
      }
    },
    {
      "id": "CE:fo:gibbs_standard",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Standard Gibbs energy and equilibrium constant",
        "ntype": "formula",
        "domain": "chem.equilibrium",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T08:54:02.662433",
        "latex": "\\Delta G^{\\circ}=-RT\\ln K",
        "informal": "标准吉布斯自由能变与平衡常数的定量关系（热力学与化学的桥梁）。"
      }
    },
    {
      "id": "CE:fo:gibbs_reaction",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Gibbs energy at arbitrary composition",
        "ntype": "formula",
        "domain": "chem.equilibrium",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T08:54:02.662433",
        "latex": "\\Delta G=\\Delta G^{\\circ}+RT\\ln Q",
        "informal": "任意组成下的反应吉布斯自由能；ΔG<0 自发正向。"
      }
    },
