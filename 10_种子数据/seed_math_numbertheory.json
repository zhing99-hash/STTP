  "note": "Number theory vertical slice",
  "nodes": [
    {
      "id": "NT:fo:congruence",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Congruence modulo n",
        "ntype": "formula",
        "domain": "math.numbertheory",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T14:06:46.546790",
        "latex": "a\\equiv b\\pmod{n}\\iff n\\mid(a-b)",
        "informal": "同余式定义：a、b 之差被 n 整除。"
      }
    },
    {
      "id": "NT:fo:euler_theorem",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Euler's theorem",
        "ntype": "formula",
        "domain": "math.numbertheory",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T14:06:46.546790",
        "latex": "a^{\\varphi(n)}\\equiv 1\\pmod{n}\\quad(\\gcd(a,n)=1)",
        "informal": "若 a 与 n 互质，则 a 的 φ(n) 次幂模 n 余 1。"
      }
    },
    {
      "id": "NT:fo:fermat_little",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Fermat's little theorem",
        "ntype": "formula",
        "domain": "math.numbertheory",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T14:06:46.546790",
        "latex": "a^{p-1}\\equiv 1\\pmod{p}",
        "informal": "欧拉定理在 n 为素数时的特例（φ(p)=p−1）。"
      }
    },
    {
      "id": "NT:fo:crt",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Chinese remainder theorem",
        "ntype": "formula",
        "domain": "math.numbertheory",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T14:06:46.546790",
        "latex": "x\\equiv a_i\\pmod{n_i}\\ \\Rightarrow\\ \\exists!\\,x\\ \\big(\\mathrm{mod}\\ \\textstyle\\prod_i n_i\\big)",
        "informal": "两两互质的模下，同余方程组有唯一解。"
      }
    },
    {
      "id": "NT:fo:wilson",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Wilson's theorem",
        "ntype": "formula",
        "domain": "math.numbertheory",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T14:06:46.546790",
        "latex": "(p-1)!\\equiv-1\\pmod{p}",
        "informal": "p 为素数的充要条件：(p−1)! ≡ −1 (mod p)。"
      }
    },
    {
      "id": "NT:fo:fundamental_arithmetic",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Fundamental theorem of arithmetic",
        "ntype": "formula",
        "domain": "math.numbertheory",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T14:06:46.546790",
        "latex": "n=\\prod_{i}p_i^{e_i}",
        "informal": "任一大于 1 的整数可唯一分解为素数幂之积。"
      }
    },
    {
      "id": "NT:fo:euclid_algorithm",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Euclidean algorithm",
        "ntype": "formula",
        "domain": "math.numbertheory",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T14:06:46.546790",
        "latex": "\\gcd(a,b)=\\gcd(b,\\ a\\bmod b)",
        "informal": "辗转相除求最大公因数。"
      }
    },
    {
      "id": "NT:fo:basel",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Basel problem",
        "ntype": "formula",
        "domain": "math.numbertheory",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T14:06:46.546790",
        "latex": "\\sum_{n=1}^{\\infty}\\frac{1}{n^{2}}=\\frac{\\pi^{2}}{6}",
        "informal": "欧拉解决的级数求和，把数论/分析结果与 π 联系起来。"
      }
    },
    {
      "id": "NT:fo:unit_group",
      "labels": [
        "Entity",
        "Formula"
      ],
      "props": {
        "name": "Multiplicative group of integers modulo n",
        "ntype": "formula",
        "domain": "math.numbertheory",
        "source": "curated_seed",
        "confidence": 1.0,
        "explicit_or_inferred": "explicit",
        "created_at": "2026-10-09T14:06:46.546790",
        "latex": "(\\mathbb{Z}/n\\mathbb{Z})^{\\times}=\\{a\\bmod n:\\gcd(a,n)=1\\}",
        "informal": "模 n 的单位构成的乘法群，阶为 φ(n)，是欧拉定理的群论表述。"
      }
    },
