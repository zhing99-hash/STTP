      "condition": "先确认样品组成及单位。",
      "source_ref": "molar"
    },
    {
      "id": "e2",
      "source": "demo:molar_mass",
      "target": "demo:amount",
      "discipline": "数学",
      "relation": "数量关系",
      "explanation": "由 M=m/n 可在 M 非零时变形得到 n=m/M。",
      "condition": "n 大于零、M 非零且单位一致。",
      "source_ref": "molar"
    },
    {
      "id": "e3",
      "source": "demo:amount",
      "target": "demo:avogadro",
      "discipline": "物理",
      "relation": "计数关系",
      "explanation": "将物质的量乘以阿伏伽德罗常数，得到所指定单元的数量。",
      "condition": "明确基本单元的种类。",
      "source_ref": "mole"
    },
    {
      "id": "e4",
      "source": "TH:fo:ideal_gas",
      "target": "TH:fo:charles",
      "discipline": "数学",
