# ============================================================================
# STTP · 根级运行环境变量模板（Phase 45 · A05）
# ----------------------------------------------------------------------------
# 用法：
#   cp .env.example .env        # 复制后按自己的环境填（.env 已被 .gitignore 排除，不会入库）
#   source env.sh               # bash / Git Bash：加载 .env
#   . .\env.ps1                 # PowerShell：加载 .env
#   bash sttp.sh <cmd>          # ★ 本项目入口**内置**加载 .env，多数情况无需手动 source
#
# ★ 本模板**不得**出现任何机器绝对路径（复评 A05：原 `.env` 硬编码了他人机器的
#   Python 解释器路径）。下列值请按自己的环境填；留空即为「不需要该能力」。
# ★ 本模板是**唯一**的环境变量权威清单：`sttp.sh` / `env.sh` / `env.ps1` 只透传
#   下列键（其它键会被忽略）。
# ============================================================================

# ---- Neo4j（可选：仅「云端对账 / 反向导出 / push」路径需要）----
# ★ Aura 免费实例必须用 `neo4j+ssc://`（跳过自签名证书）；用 `+s` 会报
#   "Unable to retrieve routing information"。Aura 的实例 ID 同时是用户名与库名。
# 四项全留空 ⇒ 完全离线工作（本地快照 + 已入库离线样例均可用，无需云端）。
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ---- 图数据源（相对**仓库根**的路径）----
# 可视化服务读取的前端投影快照。用已入库离线样例（`bash sttp.sh sample`）时无需改这里。
GRAPH_DATA_FILE=06_PoC/graph_data_phase41.json
# 查询源覆盖（可选）：留空则取 GRAPH_DATA_FILE；指向规范图可查全图。
# ★ 全图规范图 `06_PoC/etl/normalized.json` **不入库**（体积大），请自行重建。
GRAPH_SOURCE_FILE=

# ---- 可视化服务端口 ----
VIZ_PORT=8765

# ---- Python 解释器（可选）----
# ★ **留空即自动使用 PATH 中的 `python`**（见 `sttp.sh` 的 `${STTP_PYTHON:-python}`）。
#   仅当你确实要指定另一个解释器时才在此填**本机**路径。
#   ★ 请勿把任何人机器的绝对路径提交进仓库或模板；本项目只用相对路径与
#     `sys.executable` 定位解释器（见 `sttp_cli/cli.py`）。
STTP_PYTHON=
