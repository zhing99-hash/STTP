{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sttp-subgraph/v1",
  "title": "STTP 局部子图响应（GET /api/subgraph）",
  "description": "Phase 43 / 复评 A06。五态 status 与 error_code 共存：前者管『结果类别』，后者管『原因』。零依赖校验：由 06_PoC/tests/phase43_subgraph_selfcheck.py 内置的子集校验器执行。",
  "type": "object",
  "required": ["status", "reason", "error_code", "snapshot_id", "query", "query_hash", "nodes", "edges", "stats"],
  "properties": {
    "status": { "enum": ["ok", "no_result", "truncated", "timeout", "error"] },
    "reason": { "type": "string" },
    "error_code": {
      "enum": [null, "ENTITY_AMBIGUOUS", "MISSING_CONDITION", "SNAPSHOT_MISMATCH",
               "EVIDENCE_STALE", "SUBGRAPH_LIMIT_REACHED", "GRAPH_QUERY_TIMEOUT",
               "TOOL_EXECUTION_ERROR", "BAD_REQUEST"]
    },
    "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{12}$" },
    "query_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "seed": { "type": ["object", "null"] },
    "hidden_by_trust": { "type": "integer", "minimum": 0 },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "expandable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "estimated_neighbors", "token"],
        "properties": {
          "node_id": { "type": "string" },
          "estimated_neighbors": { "type": "integer", "minimum": 1 },
          "token": { "type": "string", "minLength": 16 }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["n_nodes", "n_edges", "elapsed_ms"],
      "properties": {
        "n_nodes": { "type": "integer", "minimum": 0 },
        "n_edges": { "type": "integer", "minimum": 0 },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "truncated_by": { "enum": [null, "nodes", "edges", "hops", "paths", "deadline"] },
        "pending_frontier": { "type": "integer", "minimum": 0 },
        "hidden_by_trust": { "type": "integer", "minimum": 0 },
        "missing_seeds": { "type": "array" },
        "hops": { "type": "integer" },
        "requested_hops": { "type": ["integer", "null"] },
        "pre_truncation": { "type": ["object", "null"] },
        "clamped": { "type": "object" },
        "expansions": { "type": "integer", "minimum": 0 },
        "evidence_fidelity": {
          "type": ["object", "null"],
          "properties": {
            "verified": { "type": "integer", "minimum": 0 },
            "changed": { "type": "integer", "minimum": 0 },
            "unverifiable_no_source": { "type": "integer", "minimum": 0 },
            "unverifiable_not_in_repo": { "type": "integer", "minimum": 0 },
            "n_edges_total": { "type": "integer", "minimum": 0 }
          }
        },
        "evidence_fidelity_global": {
          "type": ["object", "null"],
          "properties": {
            "verified": { "type": "integer", "minimum": 0 },
            "changed": { "type": "integer", "minimum": 0 },
            "unverifiable_no_source": { "type": "integer", "minimum": 0 },
            "unverifiable_not_in_repo": { "type": "integer", "minimum": 0 },
            "n_edges_total": { "type": "integer", "minimum": 0 }
          }
        },
        "evidence_status": { "$ref": "#/$defs/status_counts" },
        "evidence_status_global": { "$ref": "#/$defs/status_counts" },
        "evidence_status_note": { "type": "string" },
        "a04": { "type": ["object", "null"] },
        "stale_registry": { "type": ["object", "null"] },
        "session": {
          "type": "object",
          "required": ["n_nodes", "n_edges", "limit_nodes", "limit_edges"],
          "properties": {
            "n_nodes": { "type": "integer", "minimum": 0 },
            "n_edges": { "type": "integer", "minimum": 0 },
            "limit_nodes": { "type": "integer", "minimum": 1 },
            "limit_edges": { "type": "integer", "minimum": 1 },
            "exhausted": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "why": {
      "enum": ["used_in_step", "evidence_path", "user_specified", "task_anchor",
               "verified_context", "expansion"]
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "labels", "subject", "why_shown"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": ["string", "null"] },
        "type": { "type": "string", "minLength": 1 },
        "labels": { "type": "array" },
        "subject": { "type": "string" },
        "domain": { "type": "string" },
        "formula": { "type": "string" },
        "confidence": { "type": ["number", "null"] },
        "attrs": { "type": "object" },
        "why_shown": { "$ref": "#/$defs/why" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "type", "kind", "verified",
                   "verified_strict", "why_shown", "stale"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "type": { "type": "string" },
        "kind": { "type": "string" },
        "confidence": { "type": ["number", "null"] },
        "explicit_or_inferred": { "enum": ["explicit", "inferred"] },
        "verified": { "type": "boolean" },
        "verified_strict": { "type": "boolean" },
        "verification_level": { "type": ["string", "null"] },
        "verifier": { "type": ["string", "null"] },
        "evidence": { "type": ["array", "null"], "items": { "$ref": "#/$defs/evidence" } },
        "rationale": { "type": ["string", "null"] },
        "why_shown": { "$ref": "#/$defs/why" },
        "stale": {
          "type": "boolean",
          "description": "**两层合流**的唯一排除口径（Phase 45）：= (fidelity ∈ {changed, unverifiable_no_source}) ∪ (evidence_status ∈ {stale, rejected})。needs_review **不**导致 stale（不可判定 ≠ 已变更，铁律 #70）。"
        },
        "stale_reasons": { "type": "array" },
        "fidelity": { "enum": [null, "verified", "changed", "unverifiable_no_source", "unverifiable_not_in_repo"] },
        "fidelity_reasons": { "type": "array" },
        "evidence_status": { "$ref": "#/$defs/evidence_status" },
        "evidence_status_source": { "enum": ["recorded", "absent"] },
        "evidence_status_reasons": { "type": "array" },
        "evidence_status_n": {
          "type": ["object", "null"],
          "properties": {
            "evidence": { "type": "integer", "minimum": 0 },
            "with_deps": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "evidence_status": {
      "enum": [null, "valid", "stale", "needs_review", "rejected"],
      "description": "A04 验证依赖状态（Phase 45；边级聚合，多证据取**最坏**）。★ 与 `fidelity` 是**两层**，不可互相替代：fidelity 只答『来源那个字节文件变了吗』，本项还答『它依赖的参考表/验证器/依赖版本变了吗、命题是否被否决』。★ `null` = 该图上没有这条边的 A04 记录（`evidence_status_source=absent`）——**缺记录 ≠ 已验证**，不得渲染成 valid。★ `needs_review` = 本环境**不可判定**（缺的正是数据本身）⇒ 不计入 stale，但始终披露。"
    },
    "status_counts": {
      "type": ["object", "null"],
      "description": "A04 状态分列计数。六键（五态 + no_record）之和 == 边总数；`no_record` 单列（缺记录 ≠ 已验证）。",
      "properties": {
        "valid": { "type": "integer", "minimum": 0 },
        "stale": { "type": "integer", "minimum": 0 },
        "needs_review": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "no_record": { "type": "integer", "minimum": 0 },
        "n_edges_total": { "type": "integer", "minimum": 0 },
        "n_excluded_by_status": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "src", "src_ver", "src_hash", "impl", "impl_ver"],
      "properties": {
        "kind": { "type": "string" },
        "detail": { "type": "string" },
        "src": { "type": "string", "minLength": 1 },
        "src_ver": { "type": "string" },
        "src_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{8,64}$",
          "description": "证据来源在**记录时刻**的字节哈希（十六进制）。`null` = 该来源**无 locator**（模型/规则源，如 GNN/schema-axiom/LLM-review，实测 9 个来源、126 条证据、121 条边），**不可字节复算** ⇒ 与 `fidelity=unverifiable_no_source` 同源。字段**始终存在**（在 required 内），用值而非缺键表达「不可复算」——避免了「缺键」与「无值」的歧义。"
        },
        "impl": { "type": "string", "minLength": 1 },
        "impl_ver": {
          "type": "string",
          "description": "旧字段。★ A04a 实测：全库**只有一个值**（`100148c147cb`，49572/49572）⇒ 区分不出『哪个验证器版本产出了哪条证据』，且旧失效器**从不比对**它。请以 `vch` + `dvs` 为准。"
        },
        "indep": { "type": "boolean" },
        "evd": { "type": "string", "pattern": "^evd:[0-9a-f]{16}$" },
        "refs": {
          "type": "object",
          "description": "记录的参考表依赖 `{ref_id: 记录时刻内容哈希}`（仓库 blob 口径）。",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "vfr": { "type": ["string", "null"] },
        "vch": { "type": ["string", "null"] },
        "dvs": { "type": "object" },
        "status": { "$ref": "#/$defs/evidence_status" },
        "status_reasons": {
          "type": "array",
          "description": "程序化原因码：src_changed:/ref_changed:/verifier_changed:/dep_version_changed:/unverifiable_source:/unverifiable_reference:/unverifiable_verifier:/no_reference_declared/claim_rejected/hash_rewritten_without_reverify/reverified"
        },
        "ref_bindings": {
          "type": "object",
          "description": "`{ref_id: impl_declared|code_import}`。`code_import` 是**保守过近似**（验证器模块代码级 import 了该表 ⇒ 全部该验证器的证据都被判依赖它）。",
          "additionalProperties": { "enum": ["impl_declared", "code_import"] }
        }
      }
    }
  }
}
