# ============================================================================
# 公式知识图谱 · Neo4j 部署环境变量样例（复制为 .env 后按需修改）
# docker-compose.yml 与 Python 脚本（load_neo4j.py / verify_deploy.py /
# preflight_neo4j.py）均读取这些变量。
# ============================================================================

# ---- Python 驱动 / 脚本使用 ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
# 可选：指定库名（默认 neo4j）
# NEO4J_DATABASE=neo4j

# ---- docker-compose 使用（格式：user/password，须与上面一致）----
NEO4J_AUTH=neo4j/password123
